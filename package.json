{
  "name": "xuanxue-apps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "玄枢公开客户端：Web、Android 与公共客户端契约。",
  "scripts": {
    "check": "npm run check:boundary && npm run check:web",
    "check:boundary": "python3 -B scripts/check_public_boundary.py && python3 -B -m unittest scripts.test_public_boundary",
    "check:web": "node scripts/build-web.mjs",
    "build:web": "node scripts/build-web.mjs",
    "package:web": "python3 scripts/package_web.py --output dist/web/xuanxue-web.tar.gz"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luoluoluoxiaxia/xuanxue-apps.git"
  }
}
