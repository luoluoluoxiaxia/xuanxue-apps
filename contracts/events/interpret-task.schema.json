{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xx.zsien.tech/contracts/events/interpret-task.schema.json",
  "title": "Interpret task snapshot",
  "description": "GET task response and SSE event: task data. SSE sends full snapshots, not token deltas.",
  "type": "object",
  "required": ["task_id", "status", "stage"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "chart_id": {"type": ["integer", "null"]},
    "chart_session_id": {"type": ["integer", "null"]},
    "profile_id": {"type": ["integer", "null"]},
    "session_id": {"type": "string"},
    "branch_from_task_id": {"type": "string"},
    "branch_from_client_request_id": {"type": "string"},
    "branch_reason": {"type": "string"},
    "client_request_id": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["pending", "running", "done", "failed", "cancelled"]
    },
    "stage": {"type": "string"},
    "scenario": {"type": "string"},
    "topic": {"type": "string"},
    "question": {"type": "string"},
    "answer": {"type": "string"},
    "error": {"type": "string"},
    "partial": {"type": "boolean"},
    "streamable": {"type": "boolean"},
    "created_at": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]},
    "completed_at": {"type": ["string", "null"]},
    "personal_case_id": {"type": "string"},
    "public_post": {"type": "object"},
    "credits": {
      "type": "object",
      "required": [
        "required_credits",
        "daily_free_spent",
        "paid_spent",
        "platform_covered",
        "daily_remaining",
        "paid_balance_after"
      ],
      "properties": {
        "required_credits": {"type": "integer", "minimum": 0},
        "daily_free_spent": {"type": "integer", "minimum": 0},
        "paid_spent": {"type": "integer", "minimum": 0},
        "platform_covered": {"type": "integer", "minimum": 0},
        "daily_remaining": {"type": "integer", "minimum": 0},
        "paid_balance_after": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
